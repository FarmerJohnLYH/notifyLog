<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorControlHighlight">
    <item>
        <inset android:inset="2dp">
            <shape android:shape="oval">
                <gradient android:angle="270" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom"/>
                <stroke android:width="1dp" android:color="@color/glass_edge"/>
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:inset="2dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF"/></shape></inset>
    </item>
</ripple>
